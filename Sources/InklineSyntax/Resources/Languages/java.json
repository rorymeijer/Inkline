{
  "identifier": "java",
  "name": "Java",
  "fileExtensions": [
    "java"
  ],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "indentation": {
    "usesTabs": false,
    "indentWidth": 4,
    "tabWidth": 4
  },
  "patterns": [
    {
      "scope": "documentationComment",
      "pattern": "/\\*\\*[\\s\\S]*?\\*/",
      "multiline": true
    },
    {
      "scope": "comment",
      "pattern": "/\\*[\\s\\S]*?\\*/",
      "multiline": true
    },
    {
      "scope": "comment",
      "pattern": "//[^\\n]*"
    },
    {
      "scope": "string",
      "pattern": "\"\"\"[\\s\\S]*?\"\"\"",
      "multiline": true
    },
    {
      "scope": "string",
      "pattern": "\"(?:[^\"\\\\\\n]|\\\\.)*\""
    },
    {
      "scope": "character",
      "pattern": "'(?:[^'\\\\\\n]|\\\\.)'"
    },
    {
      "scope": "attribute",
      "pattern": "@[A-Za-z_]\\w*"
    },
    {
      "scope": "number",
      "pattern": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFlLuUdD]?)\\b"
    },
    {
      "scope": "storage",
      "pattern": "\\b(?:abstract|class|enum|extends|final|implements|import|interface|native|package|private|protected|public|record|sealed|static|strictfp|synchronized|transient|volatile|permits|non-sealed)\\b"
    },
    {
      "scope": "controlKeyword",
      "pattern": "\\b(?:assert|break|case|catch|continue|default|do|else|finally|for|if|instanceof|return|switch|throw|throws|try|while|yield)\\b"
    },
    {
      "scope": "type",
      "pattern": "\\b(?:boolean|byte|char|double|float|int|long|short|void|var)\\b"
    },
    {
      "scope": "constant",
      "pattern": "\\b(?:true|false|null|this|super)\\b"
    },
    {
      "scope": "keyword",
      "pattern": "\\b(?:new)\\b"
    },
    {
      "scope": "type",
      "pattern": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "scope": "function",
      "pattern": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captureGroup": 1
    }
  ],
  "symbols": [
    {
      "kind": "method",
      "pattern": "^\\s*(?:(?:public|private|protected|static|final|abstract|synchronized|native|default)\\s+)+[\\w<>\\[\\], .]+\\s+([A-Za-z_]\\w*)\\s*\\(",
      "nameGroup": 1
    },
    {
      "kind": "class",
      "pattern": "^\\s*(?:(?:public|private|protected|abstract|final|sealed)\\s+)*class\\s+([A-Za-z_]\\w*)",
      "nameGroup": 1
    },
    {
      "kind": "interface",
      "pattern": "^\\s*(?:public\\s+)?interface\\s+([A-Za-z_]\\w*)",
      "nameGroup": 1
    },
    {
      "kind": "enum",
      "pattern": "^\\s*(?:public\\s+)?enum\\s+([A-Za-z_]\\w*)",
      "nameGroup": 1
    }
  ],
  "treeSitter": {
    "grammar": "java",
    "library": "libtree-sitter-java.dylib",
    "highlightsQuery": "java/highlights.scm"
  },
  "brackets": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "folding": "brackets"
}
