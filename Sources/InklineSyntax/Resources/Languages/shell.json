{
  "identifier": "shell",
  "name": "Shell",
  "fileExtensions": [
    "sh",
    "bash",
    "zsh",
    "ksh",
    "command",
    "bashrc",
    "zshrc",
    "profile"
  ],
  "fileNames": [
    ".bashrc",
    ".zshrc",
    ".bash_profile",
    ".profile"
  ],
  "firstLinePattern": "^#!.*\\b(?:ba|z|k|d)?sh\\b",
  "comments": {
    "line": "#"
  },
  "indentation": {
    "usesTabs": false,
    "indentWidth": 2,
    "tabWidth": 4
  },
  "patterns": [
    {
      "scope": "comment",
      "pattern": "#[^\\n]*"
    },
    {
      "scope": "string",
      "pattern": "<<-?\\s*[\\'\"]?(\\w+)[\\'\"]?[\\s\\S]*?^\\s*\\1",
      "multiline": true
    },
    {
      "scope": "string",
      "pattern": "\"(?:[^\"\\\\\\n]|\\\\.)*\""
    },
    {
      "scope": "string",
      "pattern": "'(?:[^'\\\\\\n]|\\\\.)*'"
    },
    {
      "scope": "variable",
      "pattern": "\\$\\{[^}]*\\}|\\$[A-Za-z_]\\w*|\\$[0-9@*#?$!-]"
    },
    {
      "scope": "number",
      "pattern": "\\b\\d+\\b"
    },
    {
      "scope": "controlKeyword",
      "pattern": "\\b(?:if|then|else|elif|fi|case|esac|for|while|until|do|done|in|select|break|continue|return)\\b"
    },
    {
      "scope": "storage",
      "pattern": "\\b(?:function|local|export|declare|readonly|typeset|alias|unalias|source|eval|exec|set|unset|shift|trap)\\b"
    },
    {
      "scope": "function",
      "pattern": "\\b(?:echo|printf|read|cd|pwd|test|exit|cat|grep|sed|awk|cut|sort|uniq|head|tail|find|xargs|curl|git|mkdir|rm|cp|mv|chmod|ln|touch)\\b"
    },
    {
      "scope": "operator",
      "pattern": "[|&;<>()]{1,2}"
    }
  ],
  "symbols": [
    {
      "kind": "function",
      "pattern": "^\\s*(?:function\\s+)?([A-Za-z_]\\w*)\\s*\\(\\s*\\)\\s*\\{",
      "nameGroup": 1
    },
    {
      "kind": "variable",
      "pattern": "^\\s*(?:readonly|export|declare)\\s+([A-Za-z_]\\w*)=",
      "nameGroup": 1
    }
  ],
  "treeSitter": {
    "grammar": "bash",
    "library": "libtree-sitter-bash.dylib",
    "highlightsQuery": "bash/highlights.scm"
  },
  "brackets": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "folding": "brackets"
}
