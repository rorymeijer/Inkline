    "indentGuide": "#E4E4E8",
    "invisibles": "#C8C8CC",
    "findHighlight": "#FFE9A8",
    "currentFindHighlight": "#FFC64D",
    "bracketMatch": "#D5E8FF",
    "pageGuide": "#EDEDF0",
    "diffInserted": "#E4F7E7",
    "diffDeleted": "#FCE8E8",
    "bookmark": "#3E7BFA"
  },
  "scopes": {
