    "heading": {
      "color": "#0F6FC5",
      "bold": true
    },
    "emphasis": {
      "italic": true
    },
    "strong": {
      "bold": true
    },
    "link": {
      "color": "#0B63C5",
      "underline": true
    },
    "listMarker": "#9B2393",
    "preprocessor": "#78492A",
