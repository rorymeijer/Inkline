    "type": "#FFE680",
    "constant": "#FFB86C",
    "number": "#FFD479",
    "string": "#7CFF7C",
    "escapeSequence": "#56B6C2",
    "regularExpression": "#56B6C2",
    "function": "#79C8FF",
    "property": "#E06C75",
    "variable": "#E8E8ED",
    "operator": "#ABB2BF",
    "punctuation": "#9196A1",
    "attribute": "#E5C07B",
    "tag": "#E06C75",
    "tagAttribute": "#D19A66",
    "heading": {
      "color": "#61AFEF",
      "bold": true
    },
    "emphasis": {
      "italic": true
    },
    "strong": {
      "bold": true
    },
    "link": {
      "color": "#61AFEF",
      "underline": true
    },
    "listMarker": "#C678DD",
    "preprocessor": "#C18A56",
    "error": {
      "color": "#E06C75",
      "underline": true
    }
