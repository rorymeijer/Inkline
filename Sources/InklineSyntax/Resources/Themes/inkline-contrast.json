    "indentGuide": "#3A3A3A",
    "invisibles": "#44464C",
    "findHighlight": "#7A6A00",
    "currentFindHighlight": "#FFD400",
    "bracketMatch": "#3A4D66",
    "pageGuide": "#2A2C31",
    "diffInserted": "#1E3225",
    "diffDeleted": "#3A2224",
    "bookmark": "#6699FF"
  },
  "scopes": {
